# Copy to .env for local (non-Docker) development. Never commit a real .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://tesla:tesla@localhost:5432/dhaka_tesla_pool
# Generate a long random value, for example: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
BCRYPT_COST=10
LOG_LEVEL=info
# Optional: only needed if the browser calls the API directly instead of through Next.js
CORS_ORIGIN=
