# Copy to .env to override Docker Compose defaults. Never commit a real .env.
# Every value has a working default, so `docker compose up --build` needs no .env at all.

# --- Database ---
POSTGRES_USER=tesla
POSTGRES_PASSWORD=tesla
POSTGRES_DB=dhaka_tesla_pool
DB_PORT=5432

# --- API ---
API_PORT=4000
# REQUIRED for any public deployment: openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-before-deploying-1234
# true loads the demo cast (Jashim, Bullet, Nusrat, Rafiq, Shirin). Idempotent.
SEED_ON_START=true
LOG_LEVEL=info
